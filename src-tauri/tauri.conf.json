{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyra",
  "version": "1.0.0",
  "identifier": "com.lyra.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Lyra — Lecteur de musique",
        "width": 1180,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
